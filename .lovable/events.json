{
  "schema_version": 1,
  "events": {
    "project.listing_renewal_confirmed": {
      "event_schema_version": 1,
      "description": "A user-initiated payment-status check independently confirms a pending Daraja payment; visibility_extended excludes sandbox payments.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "live"
            ]
          },
          "visibility_extended": {
            "type": "boolean"
          },
          "amount_kes": {
            "type": "number"
          },
          "days": {
            "type": "number"
          }
        }
      }
    },
    "project.listing_renewal_requested": {
      "event_schema_version": 1,
      "description": "Daraja accepts a newly initiated listing renewal prompt after the owner confirms phone and amount.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "listing_type": {
            "type": "string",
            "enum": [
              "ip_asset",
              "service"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "live"
            ]
          },
          "amount_kes": {
            "type": "number"
          },
          "days": {
            "type": "number"
          }
        }
      }
    },
    "project.verification_reviewed_v2": {
      "event_schema_version": 1,
      "description": "An authenticated administrator saves an IP verification review decision, with a bounded non-personal asset category.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "needs_documents",
              "kipi_confirmation",
              "inconclusive",
              "reopen"
            ]
          },
          "asset_category": {
            "type": "string",
            "enum": [
              "patent",
              "utility_model",
              "industrial_design",
              "trademark",
              "copyright",
              "trade_secret"
            ]
          }
        }
      }
    },
    "project.verification_submitted_v2": {
      "event_schema_version": 1,
      "description": "Successful private verification submission with a bounded non-personal asset category.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_category": {
            "type": "string",
            "enum": [
              "patent",
              "utility_model",
              "industrial_design",
              "trademark",
              "copyright",
              "trade_secret"
            ]
          },
          "has_certificate": {
            "type": "boolean"
          },
          "linked_listing": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
